# Copy to `apps/browser/.env` (untracked) and fill in. Vite exposes only VITE_-prefixed vars.

# Google OAuth Client Secret for "Continue with Google" on the Kolloq account gate.
#
# The matching Client ID is committed as the default in
# apps/browser/src/openWorkGoogleAuth.ts — a Client ID is a public identifier, but this secret
# is NOT, so it lives here and never in git.
#
# Where to get it: Google Cloud Console -> APIs & Services -> Credentials -> the Kolloq
# OAuth 2.0 Client ID -> "Client secret" (or Reset secret). Restart `pnpm dev` after editing;
# Vite only reads env files at startup.
#
# Until this is set the Google button stays disabled rather than dead-ending the user after
# they have already logged in at Google.
VITE_GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: override the committed Client ID to point a fork at its own Google project.
# VITE_GOOGLE_OAUTH_CLIENT_ID=<id>.apps.googleusercontent.com

# Billing worker URL (services/billing-worker, NEW-232) — not a secret, and live at the URL
# below. Until this is set, the "Upgrade"/"Billing portal"/"Change plan" buttons in Account &
# Plan stay disabled rather than pointing at a URL that doesn't exist.
VITE_BILLING_API_URL=https://newvector-billing-worker.kolloq.workers.dev
