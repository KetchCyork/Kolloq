{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "New Vector Cowork",
  "version": "0.1.0",
  "identifier": "ai.newvector.cowork",
  "build": {
    "beforeDevCommand": "pnpm --filter @newvector/browser dev",
    "beforeBuildCommand": "pnpm --filter @newvector/desktop sidecar:bundle && pnpm --filter @newvector/browser build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../browser/dist"
  },
  "app": {
    "windows": [
      {
        "title": "New Vector Cowork",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis", "appimage", "deb"],
    "resources": {
      "../sidecar/dist/tool-host.cjs": "sidecar/dist/tool-host.cjs",
      "../sidecar/runtime/": "sidecar/runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "hardenedRuntime": true,
      "entitlements": null
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/KetchCyork/Open-Work/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwNzk5MTFDNDVEMzU0MDYKUldRR1ZOTkZISkY1d0xoR3M2Y0J4SlVBQWdoSGJHV3kwNXA1WmN3V01ZUUtHM0F3azlUWkJkQ0cK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
