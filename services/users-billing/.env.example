# Local/throwaway Postgres only. Never put real credentials or a production
# connection string in this file — copy it to .env (gitignored) and fill in
# a local dev value.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/users_billing
PORT=3100

# Stripe TEST-mode secret key only (starts with sk_test_ or rk_test_) — the server
# refuses to start with a live key. Get one from Stripe Dashboard -> Developers ->
# API keys. Never commit a real value; this file holds a placeholder only.
STRIPE_SECRET_KEY=sk_test_...
